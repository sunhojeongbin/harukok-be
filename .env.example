# 필수. development · test · production. Swagger · 테스트 로그인은 development · test 에서만 켜진다
NODE_ENV=development
# Homebrew postgresql@18 기본값: Mac 사용자 이름, 비밀번호 없음
DATABASE_URL=postgresql://<mac-user>@localhost:5432/harukok_dev
TEST_DATABASE_URL=postgresql://<mac-user>@localhost:5432/harukok_test
# 아래는 이름만. 값은 서버 환경변수로만 주입 (설계 P8). 2단위부터 부팅 시 필수
JWT_ACCESS_SECRET=             # 32자 이상. 액세스 토큰(HS256) 서명 — 리프레시 토큰은 무작위 값이라 비밀키가 없다
TOKEN_ENCRYPTION_KEY=          # AES-256-GCM, base64 32바이트
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=             # .p8 내용 (한 줄이면 줄바꿈을 \n 으로)
APPLE_CLIENT_ID=               # 네이티브 앱 번들 ID (Service ID 아님)
GOOGLE_CLIENT_IDS=             # iOS,Android,서버 — 쉼표 구분
KAKAO_APP_KEYS=                # 카카오 OIDC id_token 의 aud (앱 키) — 쉼표 구분
KAKAO_ADMIN_KEY=               # 탈퇴 시 카카오 unlink (서버 호출, 어드민 키)
# 개발 전용 테스트 로그인 (docs/guides/swagger-social-login.md). true·false 만. 운영에서 true 면 부팅 실패
DEV_TEST_LOGIN=false
# 같은 IP 의 1분당 요청 상한 (/health 제외, 기본 30)
RATE_LIMIT_PER_MINUTE=30
# 앞단 프록시 · 로드밸런서 단수. 0 이면 X-Forwarded-For 를 믿지 않는다 — 프록시 뒤에 배포하면 반드시 맞출 것
TRUST_PROXY=0
